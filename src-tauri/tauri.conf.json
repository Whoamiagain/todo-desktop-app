{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "todo-desktop-app",
  "version": "0.1.0",
  "identifier": "com.khoi0.todo-desktop-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "todo-desktop-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyRDQ1OTNDRDUyQTM4OEMKUldTTU9DclZQRm5VMGttWllQR3FwRXY1YThoWnc3cDZFWFRFSjhLZjlkWmRGV0NpOGE1bTYweXgK",
      "endpoints": [
        "https://github.com/khoi0/todo-desktop-app/releases/latest/download/latest.json"
      ]
    }
  }
}
